/* ===== Selection inspector (edit any element on its own) ===== */
var selK="";
function hex(c){const m=(c||"").match(/[\d.]+/g);return m&&m.length>=3?"#"+m.slice(0,3).map(v=>Math.round(+v).toString(16).padStart(2,"0")).join(""):"#000000"}
function curEl(){return selK?document.querySelector('#app [data-k="'+selK+'"]'):null}
function typeOf(el){return el.matches("[data-p]")?"text":el.matches(".btn,.store")?"button":"box"}
function tagKeys(){
 const q=(sel,f)=>document.querySelectorAll("#app "+sel).forEach(f);
 q("[data-p]",el=>el.dataset.k=el.dataset.p);
 q(".btn[data-go]",el=>el.dataset.k="b."+el.dataset.go);
 q(".store",el=>el.dataset.k="b."+el.dataset.store);
 q(".totop",el=>el.dataset.k="b.top");
 q(".back",el=>el.dataset.k="b.back");
 q("[data-cyc]",el=>el.dataset.k="i."+el.dataset.cyc);
 q(".avatar",el=>el.dataset.k="i.avatar");
 if(view>=0)document.querySelectorAll("#app [data-k]").forEach(el=>el.dataset.k="p"+view+":"+el.dataset.k);
}
function applyOv(){
 const ov=C.ov||{};
 document.querySelectorAll("#app [data-k]").forEach(el=>{const o=ov[el.dataset.k];if(!o)return;if(o.size)el.style.zoom=o.size/100;if(o.color)el.style.color=o.color;if(o.fill)el.style.background=o.fill});
}
function select(el){
 document.querySelectorAll(".sel").forEach(x=>x.classList.remove("sel"));
 const I=$("#ins");
 if(!el||!editing){selK="";I.classList.remove("show");return}
 selK=el.dataset.k;el.classList.add("sel");
 const ty=typeOf(el),o=(C.ov||{})[selK]||{},cs=getComputedStyle(el);
 I.dataset.type=ty;I.dataset.cyc=el.dataset.cyc?"1":"";I.dataset.link=el.dataset.store?"1":"";I.classList.add("show");
 $("#inT").textContent=ty==="text"?"Text · “"+el.textContent.trim().slice(0,20)+"”":ty==="button"?"Button":"Image";
 $("#inColor").value=o.color||hex(cs.color);$("#inFill").value=o.fill||hex(cs.backgroundColor);$("#inSize").value=o.size||100;syncVals();
}
function reselect(){if(!selK)return;select(editing?curEl():null)}
const ovSet=(k,v)=>{const o=C.ov=C.ov||{};(o[selK]=o[selK]||{})[k]=v;save(1)};
$("#inColor").oninput=e=>{const el=curEl();if(!el)return;ovSet("color",e.target.value);el.style.color=e.target.value};
