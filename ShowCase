 const fin=()=>{if(--p)return;let ok=true;n.media.push(...add);try{store()}catch(x){ok=false;n.media.splice(n.media.length-add.length,add.length)}msg=ok?(bad.length?"Skipped (PNG, GIF or HTML under 1.5 MB only): "+bad.join(", "):""):"Not enough browser storage. Try smaller files.";render()};
 fs.forEach(f=>{const h=/\.html?$/i.test(f.name),im=/\.(png|gif)$/i.test(f.name);if(!(h||im)||f.size>1500000){bad.push(f.name);fin();return}const r=new FileReader();r.onload=()=>{add.push({t:h?"html":"img",name:f.name,src:r.result});fin()};h?r.readAsText(f):r.readAsDataURL(f)})});
