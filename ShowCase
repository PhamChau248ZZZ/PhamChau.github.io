/* ===== Undo / redo ===== */
var hist=[],hp=-1,lastT=0;
function updUR(){const u=$("#undo"),r=$("#redo");if(u)u.disabled=hp<=0;if(r)r.disabled=hp>=hist.length-1}
function snapNow(){hist=[JSON.stringify(C)];hp=0;updUR()}
function commit(co){const s=JSON.stringify(C);if(s===hist[hp])return;const n=Date.now();if(co&&n-lastT<900&&hp===hist.length-1&&hp>0)hist[hp]=s;else{hist.length=hp+1;hist.push(s);hp++;if(hist.length>80){hist.shift();hp--}}lastT=n;updUR()}
function goH(d){const n=hp+d;if(n<0||n>=hist.length)return;hp=n;C=JSON.parse(hist[hp]);try{store()}catch(e){}render();updUR()}
$("#undo").onclick=()=>goH(-1);
$("#redo").onclick=()=>goH(1);
document.addEventListener("keydown",e=>{if(!editing||!(e.ctrlKey||e.metaKey))return;if(e.target.closest&&e.target.closest("dialog,textarea,input"))return;const k=e.key.toLowerCase();if(k==="z"){e.preventDefault();goH(e.shiftKey?1:-1)}else if(k==="y"){e.preventDefault();goH(1)}});

/* ===== Show values + copy / paste (hex codes and numbers) ===== */
function norm(h){h=h.trim().replace(/^#/,"");if(/^[0-9a-f]{3}$/i.test(h))h=h.split("").map(c=>c+c).join("");return /^[0-9a-f]{6}$/i.test(h)?"#"+h.toLowerCase():null}
function syncVals(){document.querySelectorAll(".hx,.rv").forEach(t=>{const i=t.previousElementSibling;if(i&&document.activeElement!==t)t.value=i.value})}
function mkCopy(get){
 const b=document.createElement("button");b.type="button";b.className="cp";b.textContent="📋";b.title="Copy";b.setAttribute("aria-label","Copy value");
 b.onclick=async()=>{const t=get();try{await navigator.clipboard.writeText(t)}catch(e){const a=document.createElement("textarea");a.value=t;document.body.appendChild(a);a.select();try{document.execCommand("copy")}catch(_){}a.remove()}b.textContent="✓";setTimeout(()=>{b.textContent="📋"},900)};
 return b;
}
(function enhance(){
 document.querySelectorAll(".sp input[type=color],.ins input[type=color]").forEach(i=>{
  const t=document.createElement("input");t.type="text";t.className="hx";t.maxLength=7;t.spellcheck=false;t.setAttribute("aria-label","Color code");t.value=i.value;
  const b=mkCopy(()=>t.value);i.after(t);t.after(b);
  i.addEventListener("input",()=>{t.value=i.value});
  t.addEventListener("focus",()=>t.select());
  t.addEventListener("input",()=>{const n=norm(t.value);if(n){i.value=n;i.dispatchEvent(new Event("input",{bubbles:true}))}});
  t.addEventListener("blur",()=>{t.value=i.value});
 });
 document.querySelectorAll(".sp input[type=range],.ins input[type=range]").forEach(i=>{
  const u=i.dataset.st==="radius"?"px":"%";
  const t=document.createElement("input");t.type="text";t.inputMode="decimal";t.className="rv";t.maxLength=4;t.setAttribute("aria-label","Value");t.value=i.value;
  const s=document.createElement("span");s.className="un";s.textContent=u;
  const b=mkCopy(()=>t.value+u);i.after(t);t.after(s);s.after(b);
  i.addEventListener("input",()=>{t.value=i.value});
  t.addEventListener("focus",()=>t.select());
  t.addEventListener("input",()=>{const v=parseFloat(t.value.replace(/[^\d.]/g,""));if(!isNaN(v)){i.value=Math.min(+i.max,Math.max(+i.min,v));i.dispatchEvent(new Event("input",{bubbles:true}))}});
  t.addEventListener("blur",()=>{t.value=i.value});
 });
 syncVals();
})();

/* ===== Store links: open in a new tab; if the browser blocks it, show a copyable link ===== */
function showLinkMsg(u){
 const m=$("#lm");if(!m)return;
 m.textContent="Could not open the link automatically. Copy it and paste it into your browser: ";
 const i=document.createElement("input");i.readOnly=true;i.value=u;i.className="hx";i.style.width="min(100%,340px)";i.onfocus=()=>i.select();
 m.append(i,mkCopy(()=>u));
}
function openExt(u){
 let framed=true;try{framed=window.top!==window}catch(e){}
 let w=null;try{w=window.open(u,"_blank")}catch(e){}
 if(w)return;
 if(!framed){location.href=u;return}
 try{window.top.location.href=u}catch(e){}
