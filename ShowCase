 catch(e){const c=e&&e.code;say(c==="conflict"?"Someone published first — reloading…":c==="not_writer"||c==="not_granted"?"Only the page owner can publish.":c==="too_large"?"Page is too large. Remove some files or images.":c==="rate_limited"?"Too fast — wait a moment and try again.":"Could not publish. Try again.")}
