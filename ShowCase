/* ===== Publish for everyone (owner only) ===== */
let ART=null;
const buildHtml=()=>{
 const st=JSON.stringify(C).replace(/</g,"\\u003c");
 return "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n"+HEAD+"\n<style id=\"css\">"+document.getElementById("css").textContent+"</style>\n</head>\n<body>\n<script id=\"state\" type=\"application/json\">"+st+"<\/script>\n<script id=\"code\">"+document.getElementById("code").textContent+"<\/script>\n</body>\n</html>";
};
